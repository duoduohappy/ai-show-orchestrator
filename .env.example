# 本地 llama.cpp 兼容 API；不需要密钥
AI_PROVIDER=compatible
AI_BASE_URL=http://127.0.0.1:8790/v1
AI_MODEL=interview-qwen
AI_API_KEY=
# 使用 Dify Chat 应用时：AI_PROVIDER=dify，AI_BASE_URL=http://你的Dify/v1
# 密钥只放本机 .env，不能放网页、源码包或聊天。
OBS_MODE=real
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=
SHOW_ENABLE_LIVE_CONTROL=true
# 本机安装 ComfyUI 后再填写，不配置就明确返回未接入
COMFY_URL=

OBS_TRANSPORT=direct
SHOW_OPERATOR_PASSWORD=demo123!
# Render 使用平台变量和持久磁盘，本机可不设置 DATA_DIR
